# Backend Configuration
DJANGO_SECRET_KEY=django-insecure-replace-this-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL configuration for future use)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parking_db
DB_ENGINE=django.db.backends.postgresql
DB_NAME=parking_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
